# WARNING: anything prefixed VITE_ is bundled into client-side JS and visible to every user.
# Leave keys empty to run with built-in fallback content.
# "anthropic" (default) or "openai"
VITE_AI_PROVIDER=anthropic
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=
# optional, OpenAI only
VITE_OPENAI_MODEL=gpt-4o-mini
